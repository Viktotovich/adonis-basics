@layout({ title: movie.title })
  @slot('meta')
    <meta name="description" content="{{ movie.summary }}" />
  @endslot
  
  <section>
    <h1>
      {{ movie.title }}
    </h1>

    <dl class="text-sm py-4">
      <div class="flex">
        <dt class="w-24">
          Writer:
        </dt>
        <dd>
          <a href="{{ route('writers.show', { id: movie.writer.id}) }}">
            {{ movie.writer.fullName }}
        </a>
        </dd>
      </div>
      <div class="flex">
        <dt class="w-24">
          Director:
        </dt>
        <dd>
          <a href="{{ route('directors.show', { id: movie.director.id}) }}">
            {{ movie.director.fullName }}
        </a>
        </dd>
      </div>
    </dl>

    @if (movie.abstract)
      <div class="my-8 py-8 px-4 bg-slate-100 rounded-xl ">
        {{{ movie.abstract }}}
      </div>
    @else
      <p>
        No abstract
      </p>
    @endif
    <!--you can call inspect() method to inspect movie-->
  </section>
@end

